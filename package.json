{
  "name": "rmf-block",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development node server/index.mts",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.mts",
    "lint": "eslint",
    "test": "node --test",
    "verify:fast": "pnpm lint && pnpm test",
    "comments": "node scripts/comment-budget.mjs",
    "docker:up": "bash scripts/detect-host-ip.sh && docker compose up --build",
    "tasks:index": "bash scripts/tasks-index.sh",
    "tasks:archive": "bash scripts/tasks-archive.sh"
  },
  "dependencies": {
    "@yorkie-js/sdk": "0.7.13",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "patchedDependencies": {
      "@yorkie-js/sdk@0.7.13": "patches/@yorkie-js__sdk@0.7.13.patch"
    }
  }
}
