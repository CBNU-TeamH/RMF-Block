{
  "name": "rmf-block",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "NODE_ENV=development node server/index.mts",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.mts",
    "lint": "eslint",
    "test": "vitest run",
    "verify:fast": "pnpm lint && pnpm test",
    "comments": "node scripts/comment-budget.mjs",
    "verify:docs": "node scripts/verify-docs.mjs && node scripts/verify-doc-refs.mjs",
    "docker:up": "bash scripts/detect-host-ip.sh && docker compose up --build",
    "tasks:index": "bash scripts/tasks-index.sh",
    "tasks:archive": "bash scripts/tasks-archive.sh"
  },
  "dependencies": {
    "@yorkie-js/sdk": "0.7.13",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@yorkie-js/sdk@0.7.13": "patches/@yorkie-js__sdk@0.7.13.patch"
    }
  }
}
