# Save as `.env` beside docker-compose.yml. For a release, set HOST_LAN_IP
# before `docker compose up`; no host-IP detection script is shipped.
# In a clone, `pnpm docker:up` runs scripts/detect-host-ip.sh to attempt detection.
#
# The container only sees Docker's own network, so it can't work out the LAN
# address guests should type in. Run these on the host, outside containers:
#   Windows (PowerShell/CMD): ipconfig -- use the connected Wi-Fi/Ethernet
#     adapter's IPv4 address. Run in Windows, not WSL.
#   Linux: ip -4 addr show scope global -- use the LAN Wi-Fi/Ethernet
#     interface's inet address without its /prefix (e.g. omit /24).
#   macOS: networksetup -listallhardwareports -- find the Wi-Fi/Ethernet Device,
#     then run ipconfig getifaddr en0, replacing en0 with that Device name.
# Use the connection on the guests' LAN, not a Docker/WSL/VPN/loopback interface.
# Example: HOST_LAN_IP=192.168.0.14 (replace with your own LAN IPv4 address).
# If it changes, update this value and run `docker compose up -d` again.
# Details: README.md, Getting started.
HOST_LAN_IP=

# Leave these two empty. The host sets the workspace name and access password
# in the app: open the Host link, and the admin page asks for them (UC-010).
# Filled in, they only seed a workspace that has not been set up yet — handy
# for development and CI, ignored once the admin page has saved its own.
WORKSPACE_NAME=
WORKSPACE_PASSWORD=

# Where Yorkie's Admin API is, as this server reaches it. Startup uses it to
# register the auth webhook; without that, Yorkie accepts any client on the
# network. Compose sets it to the service name.
YORKIE_ADMIN_ADDR=

# Where this server is, as *Yorkie* reaches it — the two point opposite ways.
# `localhost` is always wrong here: inside Yorkie's container it means Yorkie.
# Unset defaults to host.docker.internal, which is right for the usual
# development setup (app run natively, Yorkie in Docker). Docker Desktop
# resolves that name on its own; plain Docker Engine on Linux needs
# `--add-host=host.docker.internal:host-gateway` on the Yorkie container.
#
# Yorkie stores this without testing it, so a wrong address registers fine and
# only surfaces later as clients failing with `verify access: send webhook`.
# Startup prints the address it registered so it can be checked at a glance.
YORKIE_AUTH_WEBHOOK_URL=
