# Save as `.env` beside docker-compose.yml. For a release, set HOST_LAN_IP
# before `docker compose up`; no host-IP detection script is shipped.
# In a clone, `pnpm docker:up` runs scripts/detect-host-ip.sh to attempt detection.
#
# The container only sees Docker's own network, so it can't work out the LAN
# address guests should type in. Each command prints this machine's address on
# its default route; run it on the host, outside containers:
#   Windows (PowerShell, not WSL):
#     (Get-NetIPConfiguration | Where-Object IPv4DefaultGateway).IPv4Address.IPAddress
#   Linux:  ip -4 route get 1.1.1.1      (the address after `src`)
#   macOS:  ipconfig getifaddr "$(route -n get default | awk '/interface:/{print $2}')"
# If it prints nothing, or a VPN address, take the Wi-Fi/Ethernet adapter's IPv4
# from `ipconfig` / `ip -4 addr` instead -- not a Docker/WSL/VPN/loopback one.
# Example: HOST_LAN_IP=192.168.0.14 (replace with your own LAN IPv4 address).
# If it changes, update this value and run `docker compose up -d` again.
# Guests also need ports 3000 and 8080 open: README.md, "Open the ports".
HOST_LAN_IP=

# Leave these two empty. The host sets the workspace name and access password
# in the app: open the Host link, and the admin page asks for them (UC-010).
# Filled in, they only seed a workspace that has not been set up yet — handy
# for development and CI, ignored once the admin page has saved its own.
WORKSPACE_NAME=
WORKSPACE_PASSWORD=

# Native development only (`pnpm dev` / `pnpm start`); Docker users leave
# these commented out. The full Compose stack sets both addresses itself
# and does not use these values from .env, even if you uncomment them.
# For an app running on the host beside Yorkie on Docker Desktop, the defaults
# match the examples below. Uncomment to override; do not set an empty value,
# because it overrides the default and makes webhook registration fail.
# App -> Yorkie's Admin API, to register the auth webhook:
# YORKIE_ADMIN_ADDR=http://localhost:8080
# Yorkie -> the app's auth endpoint (`localhost` would mean Yorkie itself):
# YORKIE_AUTH_WEBHOOK_URL=http://host.docker.internal:3000/api/internal/yorkie/auth
# On Linux Docker Engine, Yorkie needs a reachable host address or an
# extra_hosts entry for host.docker.internal:host-gateway. See CONTRIBUTING.md.
