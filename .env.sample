# Copy to `.env` and fill in before `pnpm docker:up`.
#
# The container only sees Docker's own network, so it can't work out the LAN
# address guests should type in. Find it on the host machine:
#   Windows: ipconfig                (the active adapter's IPv4 Address --
#                                     the Windows one, not WSL's)
#   Linux:   ip -4 addr              (or `hostname -I`)
#   macOS:   ipconfig getifaddr en0  (`hostname -I` is GNU-only, not on macOS)
HOST_LAN_IP=

# The workspace name guests see on the join screen. Optional.
WORKSPACE_NAME=

# The access password guests type to join, alongside their nickname
# (FR-020-02). You choose it and tell it to them — there are no complexity
# rules, only a 4-character minimum so a half-filled .env fails loudly.
WORKSPACE_PASSWORD=
